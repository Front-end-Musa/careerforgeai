{
  "name": "application",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "nx serve",
    "build": "nx build",
    "watch": "nx build --watch --configuration development",
    "test": "nx test",
    "serve:ssr:application": "node dist/application/server/server.mjs",
    "build:functions": "npm --prefix functions run build",
    "lint:functions": "npm --prefix functions run lint",
    "test:functions": "npm --prefix functions run test",
    "test:functions:emulator": "npm --prefix functions run test:emulator",
    "smoke:functions:local": "node scripts/functions-callable-smoke.mjs",
    "smoke:functions:test-port": "powershell -Command \"$env:FUNCTIONS_EMULATOR_PORT='35001'; node scripts/functions-callable-smoke.mjs\"",
    "smoke:functions:emulator": "firebase emulators:exec --project ai-job-seeker-ed1d3 --config firebase.testing.json --only functions,firestore \"npm run smoke:functions:test-port\"",
    "verify:functions": "npm run build && npm run lint:functions && npm run build:functions && npm run test:functions && npm run test:functions:emulator && npm run smoke:functions:emulator"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.18",
    "@angular/cdk": "20",
    "@angular/common": "20.3.18",
    "@angular/compiler": "20.3.18",
    "@angular/core": "20.3.18",
    "@angular/fire": "20.0.1",
    "@angular/forms": "20.3.18",
    "@angular/material": "20",
    "@angular/platform-browser": "20.3.18",
    "@angular/platform-browser-dynamic": "20.3.18",
    "@angular/platform-server": "20.3.18",
    "@angular/router": "20.3.18",
    "@angular/ssr": "^20.3.22",
    "@ngrx/effects": "20.1.0",
    "@ngrx/entity": "20.1.0",
    "@ngrx/router-store": "20.1.0",
    "@ngrx/store": "20.1.0",
    "@ngrx/store-devtools": "20.1.0",
    "@polar-sh/sdk": "^0.47.0",
    "cloc": "^2.6.0-cloc",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lru-cache": "^11.3.2",
    "lucide-angular": "^1.0.0",
    "openai": "^6.33.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "20.3.22",
    "@angular-devkit/schematics": "20.3.22",
    "@angular/build": "20.3.22",
    "@angular/cli": "20.3.22",
    "@angular/compiler-cli": "20.3.18",
    "@nx/angular": "22.6.4",
    "@nx/workspace": "22.6.4",
    "@schematics/angular": "20.3.22",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^25.5.2",
    "jasmine-core": "~6.1.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "nx": "22.6.4",
    "typescript": "5.9"
  }
}
